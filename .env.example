# ArogyaRaksha - Environment Configuration Template
# Copy this to .env and replace secrets for local or production use

# Flask Session & CSRF Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# AES-256 Master Encryption Key (Must be exactly 64 hex characters / 32 bytes)
# (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Multi-Version Key Registry (Phase 3)
# Allows decrypting historical records while rotating active keys.
# Option A: JSON mapping of version numbers to 64-hex-char keys
# KEY_REGISTRY_JSON={"1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef","2":"fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"}
# Option B: Individual env vars (e.g. ENCRYPTION_KEY_v1=..., ENCRYPTION_KEY_v2=...)
CURRENT_KEY_VERSION=1

# Database URI (Swap path between SQLite dev and PostgreSQL prod)
# Local Development (SQLite):
DATABASE_URL=sqlite:///healthcare.db
# Production (PostgreSQL with psycopg driver):
# DATABASE_URL=postgresql+psycopg://arogya_user:arogya_secure_pass@localhost:5432/arogya_db
# Or standard PostgreSQL URI (automatically translated to postgresql://):
# DATABASE_URL=postgresql://arogya_user:arogya_secure_pass@localhost:5432/arogya_db

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=False

# Session Lifetime in minutes
SESSION_LIFETIME_MINUTES=30

# Security & Network Settings
RATELIMIT_STORAGE_URI=memory://
FORCE_HTTPS=False

# Server-Side Session Storage (Phase 8)
# Local development defaults to in-memory store; production uses Redis
# REDIS_URL=redis://localhost:6379/0
# SESSION_REDIS_URL=redis://localhost:6379/1

# Multi-Factor & Proxy Configuration
MFA_ENFORCE_ADMIN=True
# TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.0/8

# Initial administrator password for `flask bootstrap-admin` (a random one is generated if unset)
# BOOTSTRAP_ADMIN_PASSWORD=

# Password reset delivery (processed by `flask process-outbox --loop`)
APP_BASE_URL=http://127.0.0.1:5000
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=True
# MAIL_FROM=no-reply@arogyaraksha.local

# Viva tamper-simulation buttons on the patient page (never available in production)
# ENABLE_TAMPER_DEMO=True

# Accept patient ciphertexts written before version-bound AAD. Turn off after running
# scripts/rotate_keys.py, which upgrades every record.
CRYPTO_ALLOW_LEGACY_AAD=True

# Key version whose HKDF subkey keys the audit hash chain; keep this key after rotation
# AUDIT_CHAIN_KEY_VERSION=1
